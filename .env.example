# ---------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) configuration
# Copy to `.env` and fill in values from your app registration.
# Never commit a real .env file - it is git-ignored.
# ---------------------------------------------------------------------------

# Directory (tenant) ID of the Entra tenant that issues the access tokens.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Expected `aud` claim. Entra v2 access tokens use the Application (client) ID
# of the API app registration (a bare GUID), even when the requested scope uses
# an Application ID URI such as api://<client-id>/mcp.invoke. List several
# exact claim values, comma-separated, only if your issuer returns more than one.
ENTRA_AUDIENCE=00000000-0000-0000-0000-000000000000

# Delegated scope that a caller must hold to invoke tools.
MCP_REQUIRED_SCOPE=mcp.invoke

# Optional: override the issuer. By default the server accepts the Entra v2
# issuer for the configured tenant:
#   https://login.microsoftonline.com/<tenant-id>/v2.0
# ENTRA_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0

# Optional: override the JWKS endpoint (defaults to the tenant's v2 keys URL).
# ENTRA_JWKS_URI=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/discovery/v2.0/keys

# HTTP listener settings.
PORT=3000
HOST=127.0.0.1

# Public base URL of this server, used for the OAuth protected-resource
# metadata document and WWW-Authenticate hints. Defaults to http://HOST:PORT.
# PUBLIC_BASE_URL=https://mcp.example.com
