{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "entraTenantId": {
      "value": "${ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000}"
    },
    "entraAudience": {
      "value": "${ENTRA_AUDIENCE=00000000-0000-0000-0000-000000000000}"
    },
    "mcpRequiredScope": {
      "value": "${MCP_REQUIRED_SCOPE=mcp.invoke}"
    },
    "createEntraAppRegistrations": {
      "value": "${CREATE_ENTRA_APP_REGISTRATIONS=false}"
    },
    "entraApiDisplayName": {
      "value": "${ENTRA_API_DISPLAY_NAME=simple-mcp-server-api}"
    },
    "entraClientDisplayName": {
      "value": "${ENTRA_CLIENT_DISPLAY_NAME=simple-mcp-server-client}"
    },
    "entraClientRedirectUri": {
      "value": "${ENTRA_CLIENT_REDIRECT_URI=http://localhost:3000/callback}"
    },
    "entraAuthorizeAzureCliClient": {
      "value": "${ENTRA_AUTHORIZE_AZURE_CLI_CLIENT=true}"
    },
    "entraAzureCliAppId": {
      "value": "${ENTRA_AZURE_CLI_APP_ID=04b07795-8ddb-461a-bbee-02f9e1bf7b46}"
    },
    "entraIssuer": {
      "value": "${ENTRA_ISSUER=}"
    },
    "entraJwksUri": {
      "value": "${ENTRA_JWKS_URI=}"
    },
    "publicBaseUrl": {
      "value": "${PUBLIC_BASE_URL=}"
    },
    "mcpExists": {
      "value": "${SERVICE_MCP_RESOURCE_EXISTS=false}"
    }
  }
}
